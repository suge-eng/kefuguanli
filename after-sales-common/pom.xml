<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.aftersales</groupId>
        <artifactId>after-sales-workorder</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>after-sales-common</artifactId>
    <description>公共模块：统一返回体 / 状态枚举 / MQ常量 / 事件体 / 全局异常</description>

    <dependencies>
        <!-- web/validation 使用 provided：仅用于编译全局异常处理器，
             不会传递给 api-gateway（避免 Gateway 引入 servlet 栈导致启动失败） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

</project>
